public class Main {
  
      public static void main(String[]args) { 
      double media = 80;
      String graduacao;
      
      if (media >= 70){
          graduacao = "A";
      } else if (media < 70 && media >= 50) {
          graduacao = "B";
      } else {
          graduacao = "C";
      }  
      
      System.out.println("Média: " + media);
      
      switch (graduacao) {
        case "A":
            System.out.println("Aprovado");
            break;
        case "B":
            System.out.println("Recuperação");
            break;
        case "C":
            System.out.println("Reprvoado");
            break;
        default:
            System.out.println("Erro!!");
            
      }
     }
